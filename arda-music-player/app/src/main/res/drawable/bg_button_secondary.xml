<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1C2635" />
            <stroke android:width="1dp" android:color="@color/electric" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#161E2A" android:endColor="#111720" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
