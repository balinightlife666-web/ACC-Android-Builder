<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/line" />
            <corners android:radius="4dp" />
            <size android:height="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:startColor="#D89E43" android:endColor="@color/gold" />
                <corners android:radius="4dp" />
                <size android:height="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
